<file path=".github/workflows/deploy.yml">
name: CI/CD Backend Despachos - Innovatech Chile

on:
  push:
    branches:
      - deploy

env:
  AWS_REGION: ${{ secrets.AWS_REGION }}
  ECR_REGISTRY: ${{ secrets.ECR_REGISTRY }}
  ECR_REPOSITORY: ep2-backend-despacho
  IMAGE_TAG: ${{ github.sha }}

jobs:
  build-and-deploy:
    name: Build, Push y Deploy Backend
    runs-on: ubuntu-latest

    steps:
      - name: Checkout código
        uses: actions/checkout@v4

      - name: Configurar Java 17
        uses: actions/setup-java@v4
        with:
          java-version: '17'
          distribution: 'temurin'

      - name: Configurar credenciales AWS
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-session-token: ${{ secrets.AWS_SESSION_TOKEN }}
          aws-region: ${{ env.AWS_REGION }}

      - name: Login a Amazon ECR
        id: login-ecr
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build y Push imagen a ECR
        run: |
          docker build \
            -t $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG \
            -t $ECR_REGISTRY/$ECR_REPOSITORY:latest \
            .
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:latest

      - name: Deploy en EC2 Backend
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.EC2_HOST_BACKEND }}
          username: ec2-user
          key: ${{ secrets.EC2_SSH_KEY }}
          script: |
            aws configure set aws_access_key_id ${{ secrets.AWS_ACCESS_KEY_ID }}
            aws configure set aws_secret_access_key ${{ secrets.AWS_SECRET_ACCESS_KEY }}
            aws configure set aws_session_token ${{ secrets.AWS_SESSION_TOKEN }}
            aws configure set default.region ${{ env.AWS_REGION }}

            aws ecr get-login-password --region ${{ env.AWS_REGION }} | \
              docker login --username AWS --password-stdin ${{ env.ECR_REGISTRY }}

            docker pull ${{ env.ECR_REGISTRY }}/${{ env.ECR_REPOSITORY }}:latest

            mkdir -p /home/ec2-user/innovatech-backend
            cd /home/ec2-user/innovatech-backend

            cat > docker-compose.yml << 'COMPOSE_EOF'
            services:
              backend:
                image: ${{ env.ECR_REGISTRY }}/${{ env.ECR_REPOSITORY }}:latest
                container_name: innovatech-backend-despacho
                ports:
                  - "8081:8081"
                environment:
                  - DB_ENDPOINT=db
                  - DB_PORT=3306
                  - DB_NAME=innovatech_despachos
                  - DB_USERNAME=root
                  - DB_PASSWORD=${{ secrets.DB_PASSWORD }}
                depends_on:
                  db:
                    condition: service_healthy
                restart: unless-stopped
                networks:
                  - innovatech-network
              db:
                image: mysql:8.0
                container_name: innovatech-db-despacho
                environment:
                  - MYSQL_DATABASE=innovatech_despachos
                  - MYSQL_ROOT_PASSWORD=${{ secrets.DB_PASSWORD }}
                volumes:
                  - mysql_data:/var/lib/mysql
                healthcheck:
                  test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-u", "root", "-p${{ secrets.DB_PASSWORD }}"]
                  interval: 10s
                  timeout: 5s
                  retries: 5
                  start_period: 30s
                restart: unless-stopped
                networks:
                  - innovatech-network
            volumes:
              mysql_data:
                driver: local
            networks:
              innovatech-network:
                driver: bridge
            COMPOSE_EOF

            docker compose down || true
            docker compose up -d

            echo "✅ Backend Despachos desplegado correctamente"
            docker compose ps
</file>

